# Use lightweight Python image
FROM python:3.9-slim

# Set working directory
WORKDIR /app

# Upgrade pip to the latest version
RUN pip install --upgrade pip

# 1. Install PyTorch CPU version (Smaller size: ~150MB vs 900MB)
# We add --default-timeout=1000 to prevent timeout errors
RUN pip install torch --index-url https://download.pytorch.org/whl/cpu --default-timeout=1000

# Copy requirements
COPY requirements.txt .

# 2. Install the rest of the dependencies (Transformers, FastAPI)
RUN pip install --no-cache-dir -r requirements.txt --default-timeout=1000

# Copy application code
COPY main.py .

# Expose port 8000
EXPOSE 8000

# Run the FastAPI server
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]